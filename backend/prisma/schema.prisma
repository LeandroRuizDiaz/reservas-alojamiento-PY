generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
model Usuario {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(100)
  email String @unique @db.VarChar(191)
  passwordHash String @db.VarChar(255)
  reservas Reserva[]
}
model Cabana {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(100)
  descripcion String @db.Text
  capacidad Int
  precioNoche Decimal @db.Decimal(12,2)
  reservas Reserva[]
}
model Huesped {
  id Int @id @default(autoincrement())
  nombre String @db.VarChar(100)
  documento String @unique @db.VarChar(30)
  telefono String @db.VarChar(40)
  reservas Reserva[]
}
model Reserva {
  id Int @id @default(autoincrement())
  cabanaId Int
  huespedId Int
  usuarioId Int
  entrada DateTime @db.Date
  salida DateTime @db.Date
  personas Int
  tarifaNoche Decimal @db.Decimal(12,2)
  estado String @default("Confirmada") @db.VarChar(20)
  creadaEn DateTime @default(now())
  cabana Cabana @relation(fields: [cabanaId], references: [id], onDelete: Restrict)
  huesped Huesped @relation(fields: [huespedId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  @@index([cabanaId, entrada, salida])
  @@index([huespedId])
  @@index([usuarioId])
}
